  "faq": [
    {
      "id": "f1",
      "q": "هل أحتاج إلى تصميم المحتوى بنفسي؟",
      "a": "لا. أرسل محتواك كما هو — نصًا أو ملفًا — ونتولى تحويله إلى تصميم مناسب لجمهورك ومستواه.",
      "enabled": true,
      "order": 1
    },
    {
      "id": "f2",
      "q": "هل أستطيع اختيار الأسلوب؟",
      "a": "نعم. اختر من الأساليب المعروضة — ويمكن اختيار أكثر من أسلوب — أو افتح أي نموذج في المعرض واضغط «أريد تصميمًا بهذا الأسلوب» ليُحدَّد تلقائيًا في طلبك.",
      "enabled": true,
      "order": 2
    },
    {
      "id": "f3",
      "q": "كم تعديلًا يشمل الطلب؟",
      "a": "تعديل مجاني واحد خلال 48 ساعة من التسليم، ضمن نفس المحتوى والأسلوب. أي تعديل إضافي بـ15 ريالًا. تغيير الموضوع أو الأسلوب يُعد طلبًا جديدًا.",
      "enabled": true,
      "order": 3
    },
    {
      "id": "f4",
      "q": "كيف يتم الدفع؟",
      "a": "بالتحويل البنكي. تظهر لك بيانات الحساب بعد إرسال الطلب مباشرة، وترسل الإيصال عبر واتساب مع رقم طلبك.",
      "enabled": true,
      "order": 4
    },
    {
      "id": "f5",
      "q": "متى يصلني التصميم؟",
      "a": "خلال 24–48 ساعة من تأكيد التحويل. ويمكن اختيار التسليم المستعجل خلال 12 ساعة برسوم إضافية.",
      "enabled": true,
      "order": 5
    },
    {
      "id": "f6",
      "q": "هل يمكنني إرسال ملف بدل كتابة المحتوى؟",
      "a": "نعم. اكتب عنوان الموضوع فقط في النموذج، ثم أرسل الملف (PDF أو Word أو صورة) عبر واتساب مع رقم طلبك.",
      "enabled": true,
      "order": 6
    },
    {
      "id": "f7",
      "q": "ما حقوق استخدام التصميم؟",
      "a": "التصميم لك لاستخدامه في فصلك أو مؤسستك أو منصاتك التعليمية. لا يشمل إعادة البيع أو التوزيع التجاري.",
      "enabled": true,
      "order": 7
    },
    {
      "id": "f8",
      "q": "هل يمكن استرجاع المبلغ؟",
      "a": "المنتجات الرقمية المخصصة غير قابلة للاسترجاع بعد بدء التنفيذ. قبل البدء يمكن الإلغاء واسترجاع المبلغ كاملًا.",
      "enabled": true,
      "order": 8
    }
  ],
